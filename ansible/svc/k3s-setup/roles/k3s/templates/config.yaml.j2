# {{ ansible_managed }}
node-name: {{ inventory_hostname | to_json }}
node-ip: {{ ansible_host | to_json }}
advertise-address: {{ ansible_host | to_json }}
write-kubeconfig-mode: "0600"
token-file: /etc/rancher/k3s/token
{% if inventory_hostname == k3s_bootstrap_host %}
cluster-init: true
{% else %}
server: {{ k3s_api_endpoint | to_json }}
{% endif %}
tls-san:
{% for host in groups['k3s_servers'] %}
  - {{ host | to_json }}
  - {{ hostvars[host].ansible_host | to_json }}
{% endfor %}
cluster-cidr: {{ k3s_cluster_cidr | to_json }}
service-cidr: {{ k3s_service_cidr | to_json }}
flannel-backend: vxlan
secrets-encryption: true
etcd-snapshot-schedule-cron: {{ k3s_etcd_snapshot_schedule | to_json }}
etcd-snapshot-retention: {{ k3s_etcd_snapshot_retention }}
{% if k3s_disable_components | length > 0 %}
disable:
{% for component in k3s_disable_components %}
  - {{ component | to_json }}
{% endfor %}
{% endif %}
